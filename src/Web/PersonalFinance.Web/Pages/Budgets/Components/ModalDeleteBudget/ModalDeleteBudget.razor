@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using PersonalFinance.Web.Resources.Budgets

<AddModal IsOpen="@ModalState.Value.IsOpen(modal: ModalType.DeleteBudget)"
          Title="@(BudgetState.Value.Budget != null ? string.Format(format: BudgetsResources.DeleteBudgetTitleFormat, arg0: BudgetState.Value.Budget.Category.Name) : string.Empty)"
          Subtitle="@BudgetsResources.DeleteBudgetMessage"
          OnClose="@HandleClose">
    <Body>
        <div class="modal-delete-budget">
            @foreach (string errorMessage in _errorMessages)
            {
                <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
            }

            <AddButton Text="@BudgetsResources.ConfirmDeletionButton" Variant="ButtonVariant.Destructive"
                       FullWidth="true" Disabled="_isSubmitting" OnClick="@HandleConfirmDeletion"/>

            <AddButton Text="@BudgetsResources.GoBackButton" Variant="ButtonVariant.Tertiary"
                       FullWidth="true" Disabled="_isSubmitting" OnClick="@HandleClose"/>
        </div>
    </Body>
</AddModal>
