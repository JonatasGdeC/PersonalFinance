@page "/budgets"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using PersonalFinance.Communication.Dtos
@using PersonalFinance.Web.Pages.Budgets.Components.BudgetChart
@using PersonalFinance.Web.Pages.Budgets.Components.CardBudget
@using PersonalFinance.Web.Pages.Budgets.Components.ModalDeleteBudget
@using PersonalFinance.Web.Pages.Budgets.Components.ModalRegisterBudget
@using PersonalFinance.Web.Pages.Budgets.Components.ModalUpdateBudget
@using PersonalFinance.Web.Resources.Budgets
@using PersonalFinance.Web.Resources.Common
@using PersonalFinance.Web.Utils.HandlerNotFound

<PageTitle>@CommonResources.AppTitlePrefix@CommonResources.Budgets</PageTitle>

<header class="budgets-header">
    <AddText Text="@CommonResources.Budgets" Preset="TextPreset.Preset1" TagHtml="TagText.H1"/>
    <AddButton Text="@BudgetsResources.AddBudgetCta" OnClick="@OpenAddBudgetModal"/>
</header>

@if (!_isLoading && !BudgetListState.Value.Budgets.Any())
{
    <HandlerNotFound Text="@BudgetsResources.NoBudgetRecorded"/>
}
else
{
    <div class="budgets-container">
        <BudgetChart IsLoading="@_isLoading"/>
        <ul class="budgets-list">
            @foreach (BudgetDto budget in BudgetListState.Value.Budgets)
            {
                <li>
                    <CardBudget Budget="@budget"/>
                </li>
            }
        </ul>
    </div>
}

<ModalRegisterBudget/>
<ModalUpdateBudget/>
<ModalDeleteBudget/>
