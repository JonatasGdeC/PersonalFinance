@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using PersonalFinance.Web.Pages.Category.Components.ModalRegisterCategory
@using PersonalFinance.Web.Pages.Transactions.Components.ModalRegisterParticipant
@using PersonalFinance.Web.Resources.Transactions

<AddModal IsOpen="@ModalState.Value.IsOpen(modal: ModalType.AddTransaction)" 
          Title="@TransactionsResources.AddTransactionTitle"
          Subtitle="@TransactionsResources.AddTransactionSubtitle"
          OnClose="@HandleClose">
    <Body>
    <form class="add-transaction-modal" @onsubmit="@HandleRegisterTransaction" @onsubmit:preventDefault="true">
        <div class="add-transaction-modal__field">
            
            <AddInput Label="@TransactionsResources.Participant"
                      Placeholder="@(!ParticipantOptions.Any() ? "Não há participantes registrados" : TransactionsResources.ParticipantPlaceholder)"
                      Options="ParticipantOptions" @bind-Value="_participantValue" 
                      Disabled="@(_isSubmitting || !ParticipantOptions.Any())"/>

            <AddButton Text="+" Variant="ButtonVariant.Secondary" Disabled="_isSubmitting"
                       OnClick="@OpenAddParticipantModal" Size="40px"/>
        </div>

        <AddInput Label="@TransactionsResources.Type" Options="TypeOptions" @bind-Value="_typeValue"
                  Disabled="_isSubmitting"/>

        <div class="add-transaction-modal__field">
            <AddInput Label="@TransactionsResources.Category" 
                      Placeholder="@(!CategoryOptions.Any() ? "Não há categorias registradas" : TransactionsResources.CategoryPlaceholder)"
                      Options="CategoryOptions" @bind-Value="_categoryValue" 
                      Disabled="@(_isSubmitting || !CategoryOptions.Any())"/>

            <AddButton Text="+" Variant="ButtonVariant.Secondary" Disabled="_isSubmitting"
                       OnClick="@OpenAddCategoryModal" Size="40px"/>
        </div>

        <AddInput Label="@TransactionsResources.Amount" Prefix="$" @bind-Value="_amountText" Required="true"
                  Disabled="_isSubmitting"/>

        <AddInput Label="@TransactionsResources.DateLabel" IsDate="true" @bind-Value="_dateText" Required="true"
                  Disabled="_isSubmitting"/>

        @foreach (string errorMessage in _errorMessages)
        {
            <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
        }

        <AddButton Text="@TransactionsResources.AddTransactionButton" Type="submit" FullWidth="true"
                   Disabled="_isSubmitting"/>
    </form>
    </Body>
</AddModal>

<ModalRegisterParticipant/>

<ModalRegisterCategory/>
