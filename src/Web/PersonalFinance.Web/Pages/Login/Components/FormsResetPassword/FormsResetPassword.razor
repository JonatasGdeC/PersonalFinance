@using PersonalFinance.Web.Resources.Login

@switch (_step)
{
    case ResetStep.Email:
        <form class="form-forgot-password" @onsubmit="@HandleForgotPassword" @onsubmit:preventDefault="true">
            <AddText Text="@LoginResources.ForgotPassword" Preset="TextPreset.Preset1" TagHtml="TagText.H1"/>

            <div class="form-forgot-password__inputs">
                <AddText Text="@LoginResources.ForgotPasswordInstructions" Preset="TextPreset.Preset4"
                         Color="ThemeColor.Grey500"/>

                <AddInput Label="@LoginResources.Email" @bind-Value="_email"
                          IsEmail="true" Required="true" Disabled="_isSubmitting"/>

                @foreach (string errorMessage in _errorMessage)
                {
                    <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
                }
            </div>

            <AddButton Text="@(_isSubmitting ? LoginResources.SendingCode : LoginResources.SendCode)"
                       Variant="ButtonVariant.Primary" Type="submit"
                       FullWidth="true" Disabled="_isSubmitting"/>

            <div class="form-forgot-password__footer">
                <AddButton Text="@LoginResources.BackToLogin" Variant="ButtonVariant.Link"
                           OnClick="@(async _ => await NavigateToLogin.InvokeAsync())"/>
            </div>
        </form>
        break;

    case ResetStep.Code:
        <form class="form-forgot-password" @onsubmit="@HandleValidateResetCode" @onsubmit:preventDefault="true">
            <AddText Text="@LoginResources.VerificationCode" Preset="TextPreset.Preset1" TagHtml="TagText.H1"/>

            <div class="form-forgot-password__inputs">
                <AddText Text="@LoginResources.VerificationCodeInstructions"
                         Preset="TextPreset.Preset4"
                         Color="ThemeColor.Grey500"/>

                <AddInput Label="@LoginResources.Code" @bind-Value="_code" Required="true" Disabled="_isSubmitting"/>

                @foreach (string errorMessage in _errorMessage)
                {
                    <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
                }
            </div>

            <AddButton Text="@(_isSubmitting ? LoginResources.ConfirmingCode : LoginResources.ConfirmCode)"
                       Variant="ButtonVariant.Primary" Type="submit"
                       FullWidth="true" Disabled="_isSubmitting"/>

            <div class="form-forgot-password__footer">
                <AddButton Text="@LoginResources.BackToLogin" Variant="ButtonVariant.Link"
                           OnClick="@(async _ => await NavigateToLogin.InvokeAsync())"/>
            </div>
        </form>
        break;

    case ResetStep.NewPassword:
        <form class="form-forgot-password" @onsubmit="@HandleResetPassword" @onsubmit:preventDefault="true">
            <AddText Text="@LoginResources.NewPassword" Preset="TextPreset.Preset1" TagHtml="TagText.H1"/>

            <div class="form-forgot-password__inputs">
                <AddText Text="@LoginResources.NewPasswordInstructions"
                         Preset="TextPreset.Preset4"
                         Color="ThemeColor.Grey500"/>

                <AddInput Label="@LoginResources.NewPassword" IsPassword="true"
                          @bind-Value="_newPassword" Required="true" Disabled="_isSubmitting"/>

                <AddInput Label="@LoginResources.ConfirmNewPassword" IsPassword="true"
                          @bind-Value="_confirmPassword" Required="true" Disabled="_isSubmitting"/>

                @foreach (string errorMessage in _errorMessage)
                {
                    <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
                }
            </div>

            <AddButton Text="@(_isSubmitting ? LoginResources.UpdatingPassword : LoginResources.ConfirmNewPassword)"
                       Variant="ButtonVariant.Primary" Type="submit"
                       FullWidth="true" Disabled="_isSubmitting"/>

            <div class="form-forgot-password__footer">
                <AddButton Text="@LoginResources.BackToLogin" Variant="ButtonVariant.Link"
                           OnClick="@(async _ => await NavigateToLogin.InvokeAsync())"/>
            </div>
        </form>
        break;
}

