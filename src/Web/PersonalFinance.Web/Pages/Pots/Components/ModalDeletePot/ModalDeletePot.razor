@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using PersonalFinance.Web.Resources.Pots

<AddModal IsOpen="@ModalState.Value.IsOpen(modal: ModalType.DeletePot)"
          Title="@(PotState.Value.Pot != null ? string.Format(format: PotsResources.DeletePotTitleFormat, arg0: PotState.Value.Pot.Name) : string.Empty)"
          Subtitle="@PotsResources.DeletePotMessage"
          OnClose="@HandleClose">
    <Body>
        <div class="modal-delete-pot">
            @foreach (string errorMessage in _errorMessages)
            {
                <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
            }

            <AddButton Text="@PotsResources.ConfirmDeletionButton" Variant="ButtonVariant.Destructive"
                       FullWidth="true" Disabled="_isSubmitting" OnClick="@HandleConfirmDeletion"/>

            <AddButton Text="@PotsResources.GoBackButton" Variant="ButtonVariant.Tertiary"
                       FullWidth="true" Disabled="_isSubmitting" OnClick="@HandleClose"/>
        </div>
    </Body>
</AddModal>
