@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using PersonalFinance.Web.Resources.Transactions

<AddModal IsOpen="@(ModalState.Value.IsOpen(modal: ModalType.AddCategory))" 
          OnClose="@HandleClose"
          Title="@TransactionsResources.AddCategoryTitle"
          Subtitle="@TransactionsResources.AddCategorySubtitle">
    <Body>
        <form class="add-category-modal" @onsubmit="HandleRegisterCategory" @onsubmit:preventDefault="true">
            <AddInput Label="@TransactionsResources.CategoryNameLabel" 
                      Placeholder="@TransactionsResources.CategoryNamePlaceholder"
                      @bind-Value="@_categoryName" Required="true" Disabled="_isSubmitting"/>
            
            <AddInput Label="@TransactionsResources.Type" 
                      Options="TypeOptions" 
                      @bind-Value="_categoryType"
                      Disabled="_isSubmitting"/>

            @foreach (string errorMessage in _errorMessages)
            {
                <AddText Text="@errorMessage" Color="ThemeColor.Red" Preset="TextPreset.Preset5Bold"/>
            }

            <AddButton Text="@TransactionsResources.AddCategoryButton" 
                       Type="submit" FullWidth="true" Disabled="_isSubmitting"/>
        </form>
    </Body>
</AddModal>
