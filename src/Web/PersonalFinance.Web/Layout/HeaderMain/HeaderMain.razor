@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using System.Globalization
@using PersonalFinance.Web.Components.AddDropdownMenu
@using PersonalFinance.Web.Resources.Common

<header class="header-main">
    <div class="select-date">
        <button @onclick="@NavigateToLastDate">
            <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true">
                <path d="M5 1L1 5L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <AddText Text="@(DateState.Value.CurrentDate.ToString(format: "MM/yyyy", provider: CultureInfo.CurrentCulture))" Preset="TextPreset.Preset3"/>
        <button @onclick="@NavigateToNextDate">
            <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>
    
    <div class="header-main__actions">
        <AddSetLanguage/>

        <div class="header-main__user-menu-wrapper">
            <button type="button" class="header-main__user-button" aria-label="@CommonResources.UserMenuAriaLabel" @onclick="ToggleUserMenu">
                @if (!string.IsNullOrWhiteSpace(value: UserState.Value.User?.ProfileImage))
                {
                    <img class="header-main__user-avatar" src="@UserState.Value.User!.ProfileImage" alt="@UserState.Value.User.Name"/>
                }
                else
                {
                    <span class="header-main__user-avatar header-main__user-avatar--placeholder">@GetInitial(name: UserState.Value.User?.Name ?? string.Empty)</span>
                }

                <AddText Text="@(UserState.Value.User?.Name ?? string.Empty)" Preset="TextPreset.Preset4Bold"/>
            </button>

            <AddDropdownMenu IsOpen="_isUserMenuOpen" OnClose="CloseUserMenu">
                <button type="button" class="add-dropdown-menu__item" @onclick="HandleEditProfileClick">@CommonResources.EditProfileCta</button>
                <hr class="add-dropdown-menu__divider"/>
                <button type="button" class="add-dropdown-menu__item" @onclick="HandleLogoutClick">@CommonResources.LogoutCta</button>
            </AddDropdownMenu>
        </div>
    </div>
</header>