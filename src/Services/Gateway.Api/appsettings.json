{
  "ReverseProxy": {
    "Routes": {
      "user-register": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User", "Methods": [ "POST" ] },
        "RateLimiterPolicy": "register-user"
      },
      "user-login": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User/login", "Methods": [ "POST" ] },
        "RateLimiterPolicy": "login"
      },
      "user-forgot-password": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User/forgot-password", "Methods": [ "POST" ] },
        "RateLimiterPolicy": "forgot-password"
      },
      "user-validate-reset-code": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User/validate-reset-code", "Methods": [ "POST" ] }
      },
      "user-reset-password": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User/reset-password", "Methods": [ "PUT" ] }
      },
      "user-authenticated": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User", "Methods": [ "PUT", "GET", "DELETE" ] },
        "AuthorizationPolicy": "default"
      },
      "user-password": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/User/password", "Methods": [ "PUT" ] },
        "AuthorizationPolicy": "default"
      },
      "finance-catchall": {
        "ClusterId": "financeCluster",
        "Match": { "Path": "/{**catch-all}" },
        "AuthorizationPolicy": "default"
      }
    }
  }
}
